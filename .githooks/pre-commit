#!/usr/bin/env sh
# doxguard dogfooding: prefer the cached native binary installed into the git dir.
# Use the common git dir so linked worktrees resolve the same cached hook.
git_dir=$(git rev-parse --git-common-dir) || exit 2
# 検査を足すときは必ず `|| exit 1` を付ける。付けずに 2 本目を並べると hook の
# 終了コードが「最後のコマンドの結果」になり、前段の BLOCKED が握り潰される。
if [ -x "$git_dir/doxguard/hooks/pre-commit" ]; then
  "$git_dir/doxguard/hooks/pre-commit" || exit 1
elif command -v doxguard >/dev/null 2>&1; then
  doxguard scan --staged --block --strict || exit 1
else
  cargo run --quiet -- scan --staged --block --strict || exit 1
fi

# --- omitnix: 生成物の鮮度検査（2026-09-11 追加） ---
# コミット済みの .omitnix/index.json が、いまのソースと食い違っていたら止める。
# 書き換えはしない。hook が生成物を書き換えると、レビューされていない内容が
# コミットへ混ざるため。止まったら `omitnix` を実行して差分を確認し、
# 生成された index.json を自分で git add すること。
# 新規ファイルの gate（--gate）は意図的に入れていない。
if command -v omitnix >/dev/null 2>&1; then
	omitnix --check || exit 1
elif command -v python >/dev/null 2>&1 && python -c "import omitnix" >/dev/null 2>&1; then
	python -m omitnix --check || exit 1
fi
